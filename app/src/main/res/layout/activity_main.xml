<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Left rail: clock, shortcuts, home -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/railMaps"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_blue"
            android:contentDescription="@string/maps"
            android:padding="12dp"
            android:src="@drawable/ic_navigation" />

        <ImageView
            android:id="@+id/railMusic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_icon_red"
            android:contentDescription="@string/music"
            android:padding="12dp"
            android:src="@drawable/ic_music" />

        <ImageView
            android:id="@+id/railPhone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_icon_green"
            android:contentDescription="@string/phone"
            android:padding="12dp"
            android:src="@drawable/ic_phone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/railHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_dark"
            android:contentDescription="@string/apps"
            android:padding="12dp"
            android:src="@drawable/ic_apps" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1">

        <!-- Dashboard: map + cards -->
        <LinearLayout
            android:id="@+id/dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/mapCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/bg_card"
                android:clipToOutline="true">

                <com.huawei.hms.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/zoomCol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_margin="10dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/zoomIn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/maps"
                        android:padding="11dp"
                        android:src="@drawable/ic_add" />

                    <ImageView
                        android:id="@+id/zoomOut"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/maps"
                        android:padding="11dp"
                        android:src="@drawable/ic_remove" />

                    <ImageView
                        android:id="@+id/recenter"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@string/maps"
                        android:padding="10dp"
                        android:src="@drawable/ic_my_location" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/destBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_dest_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dropped_pin"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/destSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/destClear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/clear"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/destGo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_green"
                        android:paddingBottom="10dp"
                        android:paddingEnd="22dp"
                        android:paddingStart="22dp"
                        android:paddingTop="10dp"
                        android:text="@string/go"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Right column cards -->
            <LinearLayout
                android:id="@+id/dashboardSidePanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/searchCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_blue"
                        android:contentDescription="@string/where_to"
                        android:padding="9dp"
                        android:src="@drawable/ic_search" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/where_to"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/where_to_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/mediaInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/art"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_red"
                            android:contentDescription="@string/music"
                            android:padding="14dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_music" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/trackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/nothing_playing"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trackArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/dashboardMusicProgress"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/music"
                        android:max="1000"
                        android:progressBackgroundTint="#80FFFFFF"
                        android:progressTint="@android:color/white"
                        android:thumbTint="@android:color/white" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnPrev"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/music"
                            android:padding="10dp"
                            android:src="@drawable/ic_skip_previous" />

                        <ImageView
                            android:id="@+id/btnPlay"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="14dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_icon_dark"
                            android:contentDescription="@string/music"
                            android:padding="14dp"
                            android:src="@drawable/ic_play" />

                        <ImageView
                            android:id="@+id/btnNext"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/music"
                            android:padding="10dp"
                            android:src="@drawable/ic_skip_next" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- App grid (the "home screen") -->
        <FrameLayout
            android:id="@+id/gridPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/appGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:columnCount="4" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
